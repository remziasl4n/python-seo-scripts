  "components": {
    "schemas": {
      "Check": {
        "properties": {
          "area": {
            "type": "string",
            "title": "Area"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "warn",
              "fail",
              "off"
            ],
            "title": "Status"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "area",
          "name",
          "status",
          "detail"
        ],
        "title": "Check"
      },
      "Column": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "type": {
            "type": "string",
            "enum": [
              "number",
              "boolean",
              "string"
            ],
            "title": "Type"
          }
        },
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "title": "Column"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Rows": {
        "properties": {
          "columns": {
            "items": {
              "$ref": "#/components/schemas/Column"
            },
            "type": "array",
            "title": "Columns"
          },
          "rows": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Rows"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "truncated": {
            "type": "boolean",
            "title": "Truncated"
          }
        },
        "type": "object",
        "required": [
          "columns",
          "rows",
          "total",
          "truncated"
        ],
        "title": "Rows"
      },
      "RunRecord": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "workspace_id": {
            "type": "string",
            "title": "Workspace Id",
            "default": "local"
          },
          "tool_id": {
            "type": "string",
            "title": "Tool Id"
          },
          "tool_title": {
            "type": "string",
            "title": "Tool Title"
          },
          "site": {
            "type": "string",
            "title": "Site"
          },
          "inputs": {
            "additionalProperties": true,
            "type": "object",
            "title": "Inputs"
          },
          "refresh": {
            "type": "boolean",
            "title": "Refresh",
            "default": false
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "done",
              "failed"
            ],
            "title": "Status",
            "default": "queued"
          },
          "progress": {
            "type": "number",
            "title": "Progress",
            "default": 0.0
          },
          "message": {
            "type": "string",
            "title": "Message",
            "default": ""
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "metrics": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "string"
                }
              ]
            },
            "type": "object",
            "title": "Metrics",
            "default": {}
          },
          "notes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Notes",
            "default": []
          },
          "row_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Row Count"
          },
          "output": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output"
          }
        },
        "type": "object",
        "required": [
          "id",
          "workspace_id",
          "tool_id",
          "tool_title",
          "site",
          "inputs",
          "refresh",
          "status",
          "progress",
          "message",
          "created_at",
          "started_at",
          "finished_at",
          "error",
          "metrics",
          "notes",
          "row_count",
          "output"
        ],
        "title": "RunRecord",
        "description": "A run as the API and the web app see it."
      },
      "Section": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path",
            "description": "URL path prefix, e.g. /blog/"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          },
          "role": {
            "type": "string",
            "enum": [
              "core",
              "outer"
            ],
            "title": "Role",
            "description": "core: the central entity's main attribute; outer: supporting topics"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "path",
          "name",
          "role"
        ],
        "title": "Section",
        "description": "A part of the site and its role in the topical map."
      },
      "SiteConfig": {
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
            "title": "Name",
            "description": "Short id used in links and run history, e.g. acme-pools"
          },
          "domain": {
            "type": "string",
            "title": "Domain",
            "description": "Full URL, e.g. https://www.example.com/"
          },
          "country": {
            "type": "string",
            "title": "Country",
            "description": "Two-letter code, e.g. us",
            "default": "us"
          },
          "language": {
            "type": "string",
            "title": "Language",
            "description": "Two-letter code, e.g. en",
            "default": "en"
          },
          "source_context": {
            "type": "string",
            "title": "Source context",
            "description": "Why the site exists and how it makes money. Decides what to cover.",
            "default": ""
          },
          "central_entity": {
            "type": "string",
            "title": "Central entity",
            "description": "The thing every section is about",
            "default": ""
          },
          "entity_type": {
            "type": "string",
            "title": "Entity type",
            "description": "e.g. product, service, place",
            "default": ""
          },
          "sections": {
            "items": {
              "$ref": "#/components/schemas/Section"
            },
            "type": "array",
            "title": "Sections",
            "default": []
          },
          "brand_terms": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Brand terms",
            "description": "Words that mark a query as branded",
            "default": []
          },
          "competitors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Competitors",
            "description": "Competitor URLs",
            "default": []
          },
          "gsc_property": {
            "type": "string",
            "title": "Search Console property",
            "description": "sc-domain:example.com, or the full URL prefix",
            "default": ""
          },
          "ga4_property_id": {
            "type": "string",
            "title": "GA4 property ID",
            "description": "Numeric, optional",
            "default": ""
          },
          "sitemaps": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sitemaps",
            "description": "Sitemap URLs",
            "default": []
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "domain"
        ],
        "title": "SiteConfig",
        "description": "One website's settings: who it's for, what it's about, and where its data is."
      },
      "SiteSummary": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "domain": {
            "type": "string",
            "title": "Domain"
          },
          "central_entity": {
            "type": "string",
            "title": "Central Entity"
          },
          "entity_type": {
            "type": "string",
            "title": "Entity Type"
          },
          "country": {
            "type": "string",
            "title": "Country"
          },
          "language": {
            "type": "string",
            "title": "Language"
          }
        },
        "type": "object",
        "required": [
          "name",
          "domain",
          "central_entity",
          "entity_type",
          "country",
          "language"
        ],
        "title": "SiteSummary"
      },
      "Sites": {
