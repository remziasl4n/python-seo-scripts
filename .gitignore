# --- Secrets -----------------------------------------------------------------
.env
.env.*
!.env.example
credentials/*
!credentials/.gitkeep
*.pem
*service-account*.json
client_secret*.json
token*.json

# --- Site / client config ----------------------------------------------------
config/sites/*
!config/sites/example.yaml
config/settings.yaml

# --- Data (keep folder structure only) ---------------------------------------
data/**/*
!data/**/
!data/**/.gitkeep
.cache/

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# --- Tooling -----------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# --- OS / editor -------------------------------------------------------------
.DS_Store
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
