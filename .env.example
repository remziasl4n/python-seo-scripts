# Copy this file to .env and fill in the values you need.
#   cp .env.example .env
# .env is gitignored — never commit real keys.
#
# This file holds secrets and machine settings. Everything about a specific
# website (domain, GSC property, brand terms, competitors) lives in
# config/sites/<site>.yaml instead.

# --- General -----------------------------------------------------------------
# Which config/sites/<name>.yaml to use when a command is run without --site
SEO_SITE=example
SEO_LOG_LEVEL=INFO

# --- Paths -------------------------------------------------------------------
SEO_DATA_DIR=data
SEO_CACHE_DIR=.cache
# Hours before cached API responses are refetched
SEO_CACHE_TTL_HOURS=24

# --- Gemini ------------------------------------------------------------------
# Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model names change often. Check https://aistudio.google.com/docs/models
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# 768, 1536 or 3072. Scores are only comparable at the same model and size.
GEMINI_EMBEDDING_DIMENSIONS=768
# Grounding with Google Search: first 5,000 searches/month free, then paid
GEMINI_GROUNDING=true

# --- Google Cloud (Search Console, GA4, Sheets) ------------------------------
# Service-account JSON key, stored in credentials/ (gitignored).
# Add the service-account email as a user on each GSC property / GA4 property.
GOOGLE_APPLICATION_CREDENTIALS=credentials/service-account.json

# API key for Knowledge Graph Search, PageSpeed Insights and Natural Language
# (https://console.cloud.google.com/apis/credentials — enable each API first)
GOOGLE_API_KEY=

# --- SERP and keyword data (optional, paid) ----------------------------------
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
SERPAPI_API_KEY=
AHREFS_API_KEY=
SEMRUSH_API_KEY=

# --- Crawler -----------------------------------------------------------------
CRAWLER_USER_AGENT=Mozilla/5.0 (compatible; seo-toolkit/0.1)
CRAWLER_CONCURRENCY=5
CRAWLER_TIMEOUT_SECONDS=20
# Delay between requests to the same host
CRAWLER_DELAY_SECONDS=0.5
