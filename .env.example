# Copy this file to .env and fill in the values you need.
#   cp .env.example .env
# .env is gitignored — never commit real keys.

# --- General -----------------------------------------------------------------
# Default site used when a command is run without --site
SEO_DEFAULT_SITE=https://www.example.com/
SEO_DEFAULT_COUNTRY=us
SEO_DEFAULT_LANGUAGE=en
SEO_LOG_LEVEL=INFO

# --- Paths -------------------------------------------------------------------
SEO_DATA_DIR=data
SEO_CACHE_DIR=.cache
# Hours before cached API responses are refetched
SEO_CACHE_TTL_HOURS=24

# --- Google (Search Console, GA4, Sheets) ------------------------------------
# Service-account JSON key, stored in credentials/ (gitignored).
# Add the service-account email as a user on each GSC property / GA4 property.
GOOGLE_APPLICATION_CREDENTIALS=credentials/service-account.json
# GSC property: "sc-domain:example.com" or "https://www.example.com/"
GSC_PROPERTY=sc-domain:example.com
# GA4 numeric property ID (Admin > Property settings)
GA4_PROPERTY_ID=
# Optional: Google Sheet ID for exporting reports
GOOGLE_SHEETS_OUTPUT_ID=

# --- Third-party SEO tools (optional) ----------------------------------------
AHREFS_API_KEY=
SEMRUSH_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
VALUESERP_API_KEY=

# --- Crawler -----------------------------------------------------------------
CRAWLER_USER_AGENT=Mozilla/5.0 (compatible; seo-toolkit/0.1)
CRAWLER_CONCURRENCY=5
CRAWLER_TIMEOUT_SECONDS=20
# Delay between requests to the same host
CRAWLER_DELAY_SECONDS=0.5

# --- LLM (optional, for keyword intent / clustering labels) ------------------
ANTHROPIC_API_KEY=
